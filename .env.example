# Kopieren nach .env.local (lokal) bzw. beim Hoster als Umgebungsvariablen eintragen.
# Niemals echte Zugangsdaten ins Repository committen.

# Öffentliche Adresse der Website (ohne Schrägstrich am Ende).
# Wird für Canonical-URLs, Sitemap, robots.txt und strukturierte Daten verwendet.
NEXT_PUBLIC_SITE_URL=https://bahnstadtgrill.de

# --- Anfrageformular: E-Mail-Versand per SMTP ---------------------------------
# Ohne diese Angaben zeigt das Formular in Produktion einen Hinweis mit
# Telefonnummer statt die Anfrage zu senden.
# Beispiel Gmail: Host smtp.gmail.com, Port 465, Benutzer = Gmail-Adresse,
# Passwort = App-Passwort (Google-Konto > Sicherheit > App-Passwörter).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Empfänger der Anfragen (Standard: E-Mail-Adresse aus src/content/business.ts)
CONTACT_TO=
# Absenderadresse – muss eine gültige E-Mail-Adresse des SMTP-Kontos sein
# (Standard: SMTP_USER)
CONTACT_FROM=
